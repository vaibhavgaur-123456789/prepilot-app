# â”€â”€ Required â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# SQLite for local dev. For production use PostgreSQL:
#   1. set provider = "postgresql" in prisma/schema.prisma
#   2. DATABASE_URL="postgresql://user:pass@host:5432/preppilot?schema=public"
DATABASE_URL="file:./dev.db"

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Public base URL (used for OAuth redirects and Origin checks)
APP_URL="http://localhost:3000"

# â”€â”€ Optional: Google login â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/v1/auth/google/callback
# The Google button is hidden when these are empty.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# â”€â”€ Optional: AI coach (LLM) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Without a key the coach uses the built-in rule-based engine (still data-driven).
AI_PROVIDER="anthropic"          # anthropic | rule-based
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# â”€â”€ Optional: operations â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Protects /api/v1/cron/* (notifications, benchmark aggregation). Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# "on" enforces free/premium feature gates. "off" (default) unlocks everything.
PREMIUM_GATING="off"
# Comma-separated emails that get the ADMIN role on signup/seed
ADMIN_EMAILS=""
